extends SceneTree
## Pack the sixteen drawings generated by imagegen; never synthesize poses.
const Art = preload("res://scripts/enemy_art_import.gd")
const SOURCE_DIR = "res://docs/comic/smooth/sources/"

func _initialize() -> void:
	var jobs = JSON.parse_string(FileAccess.get_file_as_string("res://docs/comic/smooth/prompts.json"))
	var selection = OS.get_cmdline_user_args()
	var imported = 0
	for job in jobs:
		if not selection.is_empty() and job.id not in selection: continue
		if not FileAccess.file_exists(SOURCE_DIR + job.id + ".png"):
			printerr("Missing sixteen-frame source: ", job.id)
			quit(1)
			return
	for job in jobs:
		if not selection.is_empty() and job.id not in selection: continue
		if not pack_hero(SOURCE_DIR + job.id + ".png", "res://assets/comic/motion/" + job.id + ".png"):
			printerr("Invalid hero sheet: ", job.id)
			quit(1)
			return
		imported += 1
	print("HERO MOTION: packed ", imported, " sixteen-frame atlases")
	quit()

static func pack_hero(source: String, destination: String) -> bool:
	var image = Image.load_from_file(source)
	if image == null or image.get_width() % 4 != 0 or image.get_height() % 4 != 0:
		return false
	var cell_size = Vector2i(image.get_width() / 4, image.get_height() / 4)
	if absf(float(cell_size.x) / cell_size.y - 1.5) > 0.02: return false
	var cells: Array[Image] = []
	var bounds = Rect2i()
	for index in range(16):
		var cell = image.get_region(Rect2i(Vector2i(index % 4, index / 4) * cell_size, cell_size))
		var visible = Art.opaque_bounds(cell)
		if visible.size == Vector2i.ZERO: return false
		visible = visible.grow(8).intersection(Rect2i(Vector2i.ZERO, cell_size))
		bounds = visible if index == 0 else bounds.merge(visible)
		cells.append(cell)
	# Common crop and uniform scale prevent per-frame zoom or registration jumps.
	var factor = minf(584.0 / bounds.size.x, 384.0 / bounds.size.y)
	var scaled = Vector2i(Vector2(bounds.size) * factor)
	var atlas = Image.create(2400, 1600, false, Image.FORMAT_RGBA8)
	atlas.fill(Color.TRANSPARENT)
	for index in range(16):
		var cell = cells[index].get_region(bounds)
		cell.resize(scaled.x, scaled.y, Image.INTERPOLATE_LANCZOS)
		atlas.blit_rect(cell, Rect2i(Vector2i.ZERO, scaled), Vector2i(index % 4 * 600, index / 4 * 400) + (Vector2i(600, 400) - scaled) / 2)
	return atlas.save_png(destination) == OK

extends SceneTree
## Pack the sixteen drawings generated by imagegen; never synthesize poses.
const Art = preload("res://scripts/enemy_art_import.gd")
const SOURCE_DIR = "res://docs/comic/hd/sources/"

func _initialize() -> void:
	var jobs = JSON.parse_string(FileAccess.get_file_as_string("res://docs/comic/smooth/prompts.json"))
	var selection = OS.get_cmdline_user_args()
	var imported = 0
	for job in jobs:
		if not selection.is_empty() and job.id not in selection: continue
		for part in range(4):
			var path = SOURCE_DIR + job.id + "_part%d.png" % part
			if not FileAccess.file_exists(path):
				printerr("Missing HD source: ", path)
				quit(1)
				return
	for job in jobs:
		if not selection.is_empty() and job.id not in selection: continue
		if not pack_hero(job.id, "res://assets/comic/motion/" + job.id + ".png"):
			printerr("Invalid hero sheet: ", job.id)
			quit(1)
			return
		imported += 1
	print("HERO MOTION: packed ", imported, " sixteen-frame atlases")
	quit()

static func pack_hero(source: String, destination: String) -> bool:
	var id = source.get_file().get_basename()
	var cells: Array[Image] = []
	var bounds = Rect2i()
	for part in range(4):
		var path = SOURCE_DIR + id + "_part%d.png" % part
		if not FileAccess.file_exists(path): return false
		var image = Image.load_from_file(path)
		if image == null or abs(image.get_width() - 1536) > 8 or abs(image.get_height() - 1024) > 8: return false
		# Some transparent outputs trim one or two pixels; normalize the sheet grid.
		if image.get_size() != Vector2i(1536, 1024):
			image.resize(1536, 1024, Image.INTERPOLATE_LANCZOS)
		var cell_size = Vector2i(768, 512)
		for index in range(4):
			var cell = image.get_region(Rect2i(Vector2i(index % 2, index / 2) * cell_size, cell_size))
			var visible = Art.opaque_bounds(cell)
			if visible.size == Vector2i.ZERO: return false
			visible = visible.grow(8).intersection(Rect2i(Vector2i.ZERO, cell_size))
			bounds = visible if cells.is_empty() else bounds.merge(visible)
			cells.append(cell)
	# Common crop and uniform scale prevent per-frame zoom or registration jumps.
	var factor = minf(752.0 / bounds.size.x, 496.0 / bounds.size.y)
	var scaled = Vector2i(Vector2(bounds.size) * factor)
	var atlas = Image.create(3072, 2048, false, Image.FORMAT_RGBA8)
	atlas.fill(Color.TRANSPARENT)
	for index in range(16):
		var cell = cells[index].get_region(bounds)
		cell.resize(scaled.x, scaled.y, Image.INTERPOLATE_LANCZOS)
		atlas.blit_rect(cell, Rect2i(Vector2i.ZERO, scaled), Vector2i(index % 4 * 768, index / 4 * 512) + (Vector2i(768, 512) - scaled) / 2)
	return atlas.save_png(destination) == OK

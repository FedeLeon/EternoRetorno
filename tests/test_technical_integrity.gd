extends SceneTree
const Cache = preload("res://src/data/json_catalog.gd")
const Store = preload("res://src/save_store.gd")
const Content = preload("res://src/content.gd")
const Dungeon = preload("res://src/dungeon.gd")
var checks = 0
var failures = 0
func check(ok: bool, label: String) -> void:
	checks += 1
	if not ok: failures += 1; printerr("FAIL: ", label)
func text_file(path: String, text: String) -> void:
	var file = FileAccess.open(path, FileAccess.WRITE)
	file.store_string(text); file.close()
func envelope(path: String, data: Dictionary) -> void:
	var file = FileAccess.open(path, FileAccess.WRITE)
	file.store_var(data, false); file.close()
func _initialize() -> void:
	var fixture = "user://technical-catalog-%d.json" % OS.get_process_id()
	text_file(fixture, '{"items":[{"value":7}]}')
	Cache.clear(fixture)
	var first = Cache.dictionary(fixture)
	first.items[0].value = 999
	check(Cache.dictionary(fixture).items[0].value == 7, "nested cache copies are isolated")
	check(Cache.reads(fixture) == 1, "valid source read only once")
	check(Cache.array(fixture).is_empty() and not Cache.error_for(fixture).is_empty(), "wrong root has explicit diagnostic")
	check(Cache.dictionary(fixture).items[0].value == 7 and Cache.error_for(fixture).is_empty(), "correct root clears previous diagnostic")
	Cache.clear(fixture); text_file(fixture, '{broken')
	check(Cache.dictionary(fixture).is_empty() and fixture in Cache.error_for(fixture), "bad JSON identifies source")
	text_file(fixture, '{"repaired":true}')
	check(Cache.dictionary(fixture).get("repaired",false), "failed reads do not poison cache")
	Cache.clear(fixture); DirAccess.remove_absolute(fixture)
	check(Cache.dictionary(fixture).is_empty() and not Cache.error_for(fixture).is_empty(), "missing source diagnostic")
	Cache.clear(fixture)
	var a = Content.new(); var b = Content.new()
	a.cards.warrior_slash.damage = 999
	a.heroes.warrior.starter.clear()
	check(b.cards.warrior_slash.damage != 999 and b.heroes.warrior.starter.size() == 10, "game content instances isolated")
	var combos = Cache.array("res://data/synergies.json")
	combos[0].heroes.clear()
	check(Cache.array("res://data/synergies.json")[0].heroes.size() == 2, "array cache copies isolated")
	Cache.clear("res://data/dungeons.json")
	var begin = Time.get_ticks_usec()
	for index in range(1000):
		var floor = Dungeon.definition(1)
		floor.common.clear()
	check(not Dungeon.definition(1).common.is_empty(), "cached dungeon cannot be changed by caller")
	check(Cache.reads("res://data/dungeons.json") == 1, "1001 dungeon queries use one disk read")
	print("CATALOG BENCH: 1001 dungeon queries, 1 disk read, %d us (local diagnostic only)" % (Time.get_ticks_usec()-begin))
	begin = Time.get_ticks_usec()
	for index in range(1001):
		var uncached: Dictionary = JSON.parse_string(FileAccess.get_file_as_string("res://data/dungeons.json"))
		uncached["1"].common.clear()
	print("CATALOG BASELINE: 1001 uncached JSON reads/parses, %d us (local diagnostic only)" % (Time.get_ticks_usec()-begin))
	var path = "user://technical-save-%d.save" % OS.get_process_id()
	var store = Store.new(path)
	check(store.read().is_empty() and store.last_error.is_empty(), "new installation has no recovery error")
	check(store.write({"souls":10},{"rng_state":42}), "first atomic write")
	check(store.write({"souls":20},{"rng_state":43}), "second atomic write")
	check(store.read().profile.souls == 20 and not store.recovered_from_backup, "primary takes precedence")
	envelope(path, {"invalid":true})
	check(store.read().profile.souls == 10 and store.recovered_from_backup, "backup recovers invalid primary")
	check(store.write({"souls":30},{"rng_state":44}), "write after backup recovery")
	var backup = Store.new(path+".bak")
	check(backup.read().profile.souls == 10, "write does not replace backup with invalid primary")
	envelope(path, {"invalid":true})
	check(store.read().profile.souls == 10, "second corruption remains recoverable")
	check(store.write({"souls":40},{}), "recovered state can be committed again")
	store.last_error = "stale"
	check(store.read().profile.souls == 40 and store.last_error.is_empty(), "successful read clears stale errors")
	text_file(path+".tmp", "interrupted")
	check(store.read().profile.souls == 40, "temporary file never supersedes committed state")
	envelope(path, {"version":2,"profile":{},"run":{}})
	check(store.read().profile.souls == 10, "unsupported primary version falls back")
	check(store.write({"souls":50},{}), "version-one compatibility preserved")
	DirAccess.remove_absolute(path+".bak")
	DirAccess.make_dir_absolute(path+".bak")
	check(not store.write({"souls":60},{}), "backup-copy failure prevents replacing primary")
	check(not store.last_error.is_empty() and store.read().profile.souls == 50, "copy failure preserves committed state")
	DirAccess.remove_absolute(path+".bak")
	envelope(path, {"invalid":true})
	check(store.read().is_empty() and not store.last_error.is_empty(), "unrecoverable primary reports error")
	DirAccess.remove_absolute(path)
	envelope(path+".bak", {"invalid":true})
	check(store.read().is_empty() and not store.last_error.is_empty(), "invalid backup without primary reports error")
	for suffix in ["", ".bak", ".tmp"]: DirAccess.remove_absolute(path+suffix)
	print("TECHNICAL INTEGRITY: %d checks / %d failures" % [checks,failures])
	quit(1 if failures else 0)
